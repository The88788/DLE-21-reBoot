[allow-download]
<span class="attachment">
	<span class="attachment__icon"></span>
	<span class="attachment__body">
		<a class="attachment__name" href="{link}">{name}</a>
		<span class="attachment__meta">[count]{size}, скачиваний: {count}[/count]</span>
		[allow-online]<a class="attachment__online" data-highslide="file" data-type="iframe" href="{online-view-link}" target="_blank">Посмотреть онлайн</a>[/allow-online]
	</span>
</span>
[/allow-download]
[not-allow-download]
<span class="attachment attachment--denied">
	<span class="attachment__icon"></span>
	<span class="attachment__body">У вас нет доступа к скачиванию файлов с нашего сервера.</span>
</span>
[/not-allow-download]
