<article class="related-card">
	<a class="related-card__media" href="{link}" tabindex="-1" aria-hidden="true">
		[xfgiven_poster]<img class="cover-image" src="[xfvalue_thumb_url_poster]" alt="[xfvalue_image_description_poster]" width="800" height="500" loading="lazy" decoding="async">[/xfgiven_poster]
		[xfnotgiven_poster]<span class="visual"></span>[/xfnotgiven_poster]
	</a>
	<div class="related-card__body">
		<span class="chips chips--rub">{link-category}</span>
		<h3 class="related-card__title"><a href="{link}">{title}</a></h3>
		<time class="meta-item">{date}</time>
	</div>
</article>
